      "enum": [
        "NeracaHarian",
        "PenempatanBI",
        "SuratBerhargaSyariah",
        "PenempatanBankLain",
        "GiroTabungan",
        "Deposito",
        "KewajibanAntarBank",
        "Pembiayaan",
        "Kontinjensi",
        "DistribusiBagiHasil",
        "BenchmarkImbalHasil",
        "Permodalan",
        "KewajibanGWMPLM"
