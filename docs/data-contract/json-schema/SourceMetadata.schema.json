      "type": "string"
    },
    "reporting_date": {
      "format": "date",
      "title": "Reporting Date",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_reference": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Source Reference",
      "type": "string"
    },
    "source_system": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Source System",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "dataset_type",
    "reporting_date",
    "reporting_currency",
    "source_system",
    "extracted_at",
    "source_reference"
