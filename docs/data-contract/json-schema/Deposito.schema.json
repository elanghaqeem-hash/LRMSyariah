{
  "$comment": "Provisional LRM Bank Syariah Phase-1 data contract. Bank source mapping / regulatory rules not yet approved.",
  "$defs": {
    "Akad": {
      "enum": [
        "wadiah",
        "mudharabah",
        "musyarakah",
        "murabahah",
        "ijarah",
        "imbt",
        "qardh",
        "istishna",
        "kafalah",
        "wakalah",
        "other_pending_bank_approval"
      ],
      "title": "Akad",
      "type": "string"
    },
    "Segment": {
      "enum": [
        "perorangan",
        "umk",
        "korporasi",
        "pemerintah",
        "lembaga_keuangan",
        "other_pending_bank_approval"
      ],
      "title": "Segment",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "pattern": "^(?:MASK|TOKEN)-[A-Za-z0-9_-]{6,64}$",
      "title": "Account Id",
      "type": "string"
    },
    "akad": {
      "$ref": "#/$defs/Akad"
    },
    "aro_flag": {
      "title": "Aro Flag",
      "type": "boolean"
    },
    "currency": {
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "early_withdrawal_penalty": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Early Withdrawal Penalty"
    },
    "gl_code": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Gl Code",
      "type": "string"
    },
    "jatuh_tempo": {
      "format": "date",
      "title": "Jatuh Tempo",
      "type": "string"
    },
    "product_code": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Product Code",
      "type": "string"
    },
    "saldo": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "ge": "0",
      "title": "Saldo"
    },
    "segmen": {
      "$ref": "#/$defs/Segment"
    }
  },
  "required": [
    "currency",
    "account_id",
    "gl_code",
    "product_code",
    "akad",
    "jatuh_tempo",
    "aro_flag",
    "segmen",
    "saldo"
  ],
  "title": "Deposito",
  "type": "object"
}
